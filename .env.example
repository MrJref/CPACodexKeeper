# CPA management API base URL / CPA 管理 API 地址
CPA_ENDPOINT=https://your-cpa-endpoint

# CPA management token / bearer credential / CPA 管理 token
CPA_TOKEN=your-management-token

# Optional HTTP/HTTPS proxy, for example: http://127.0.0.1:7890
# 可选 HTTP/HTTPS 代理，例如：http://127.0.0.1:7890
CPA_PROXY=

# Optional OpenAI auth-flow override. oai-device-id is always generated automatically.
# 可选 OpenAI auth-flow 覆盖值。oai-device-id 始终自动生成。
OPENAI_SENTINEL_TOKEN=

# Daemon schedule as 6-field cron: second minute hour day month weekday
# 守护模式调度，6 位 cron：秒 分 时 日 月 星期
CPA_CRON="0 0/10 * * * ?"

# Optional random offset window around each Cron hit.
# CPA_INTERVAL_MIN runs early, CPA_INTERVAL_MAX runs late.
# 可选 Cron 随机偏移窗口：CPA_INTERVAL_MIN 表示最多提前，CPA_INTERVAL_MAX 表示最多延后。
# Example / 示例：Cron 命中 12:00:00 且设置 8m / 2m 时，在 11:52:00 至 12:02:00 之间随机执行。
CPA_INTERVAL_MIN=
CPA_INTERVAL_MAX=

# Remaining quota disable threshold percentage / 剩余额度禁用阈值百分比
# Disable when remaining quota is below this value; 30 means remaining quota < 30%
# 当剩余额度小于该值时禁用；30 表示剩余额度 < 30%
CPA_QUOTA_THRESHOLD=1

# Refresh threshold in days / 刷新阈值（天）
# Disabled tokens with remaining lifetime below this value can be refreshed
# 剩余有效期低于该值的已禁用 token 会进入刷新判断
CPA_EXPIRY_THRESHOLD_DAYS=3

# Whether automatic refresh is enabled / 是否启用自动刷新
# When enabled, keeper refreshes only disabled tokens; enabled tokens are left to CPA
# 开启后 keeper 只刷新已禁用 token；启用状态 token 交给 CPA 处理
# Default is true, but keeper still refreshes only disabled tokens
# 默认开启，但 keeper 仍只刷新已禁用 token
CPA_ENABLE_REFRESH=true

# Timeout for CPA API requests in seconds / CPA API 请求超时（秒）
CPA_HTTP_TIMEOUT=30

# Timeout for OpenAI usage requests in seconds / OpenAI usage 请求超时（秒）
CPA_USAGE_TIMEOUT=15

# Retry count for transient network/server failures / 临时网络或服务端错误重试次数
CPA_MAX_RETRIES=2

# Number of concurrent worker threads / 并发 worker 线程数
# Each token is still logged as a single block to avoid interleaved output
# 每个 token 的日志仍会按块输出，避免并发时控制台内容交错
CPA_WORKER_THREADS=8

# Whether to start the built-in WebUI / 是否启动内置 WebUI
# docker-compose.yml enables it by default; CLI can override with --web / --no-web
# docker-compose.yml 默认开启；命令行可用 --web / --no-web 覆盖
WEBUI_ENABLED=true

# WebUI listen address and port / WebUI 监听地址与端口
APP_HOST=0.0.0.0
APP_PORT=8765

# Maximum recent log lines kept in WebUI memory / WebUI 内存中保留的最近日志最大行数
LOG_MAX_LINES=500

# Whether WebUI login protection is enabled / 是否开启 WebUI 登录保护
# Public deployments should set AUTH_ENABLED=true and configure LOGIN_PASSWORD
# 公开部署建议开启 AUTH_ENABLED=true，并设置 LOGIN_PASSWORD
AUTH_ENABLED=false
LOGIN_PASSWORD=replace-with-your-login-password

# WebUI session lifetime, supports seconds or s/m/h/d suffix / 登录 session 有效期
AUTH_SESSION_TTL=168h
